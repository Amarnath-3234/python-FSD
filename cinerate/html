
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Rating Website</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <header>
        <h1>🎬 MovieFlix</h1>
        <nav>
            <a href="#home">Home</a>
            <a href="#categories">Categories</a>
            <a href="#movies">Movies</a>
        </nav>
    </header>

    <!-- Home Section -->
    <section class="hero" id="home">
        <h2>Discover Your Favourite Movies</h2>
        <p>Explore movies, categories and ratings.</p>
    </section>

    <!-- Categories Section -->
    <section id="categories">
        <h2>Movie Categories</h2>
        <div class="category-list">
            <button class="category-btn" data-category="All">All</button>
            <button class="category-btn" data-category="Action">Action</button>
            <button class="category-btn" data-category="Comedy">Comedy</button>
            <button class="category-btn" data-category="Horror">Horror</button>
            <button class="category-btn" data-category="Romance">Romance</button>
            <button class="category-btn" data-category="Thriller">Thriller</button>
        </div>
    </section>

    <!-- Search Section -->
    <section class="search-section">
        <input
            type="text"
            id="searchInput"
            placeholder="Search your favourite movie..."
        >
    </section>

    <!-- Movies Section -->
    <section id="movies">
        <h2>Popular Movies</h2>
        <div class="movie-container" id="movieContainer">
            <!-- Movies will appear here using JavaScript -->
        </div>
    </section>

    <!-- JavaScript -->
    <script src="script.js"></script>
</body>
</html>

